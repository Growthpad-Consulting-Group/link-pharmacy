# Copy to .env.local only when you are ready to connect Odoo.
# Odoo is OFF by default: the storefront runs on built-in demo data with no configuration.

# Set to "true" to use Odoo. Leave as "false" (or unset) to stay on demo data.
ODOO_ENABLED=false

# Base URL of your Odoo instance, no trailing slash
ODOO_URL=https://your-company.odoo.com
# Database name (Odoo.sh / on-premise: shown on the login screen)
ODOO_DB=your-database
# Login of an Odoo user with Sales + Inventory access
ODOO_USERNAME=storefront@yourcompany.com
# API key for that user (Preferences > Account Security > New API Key)
ODOO_API_KEY=

# Currency code shown on the storefront, must match the Odoo company currency
ODOO_CURRENCY=USD
# "true" confirms orders immediately (sale.order.action_confirm). "false" creates quotations.
ODOO_CONFIRM_ORDERS=false
