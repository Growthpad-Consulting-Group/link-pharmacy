# Patient portal: a long random string used to sign login cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# MongoDB Atlas. Create a cluster, a database user, and allow your server's IP under Network Access.
MONGODB_URI=mongodb+srv://arvindsharma_db_user:Enisjq4iJO5Y1Gs6@link-storefront.alur0a7.mongodb.net/
MONGODB_DB=storefront

# Copy to .env.local only when you are ready to connect Odoo.
# Odoo is OFF by default: the storefront runs on built-in demo data with no configuration.

# Set to "true" to use Odoo. Leave as "false" (or unset) to stay on demo data.
ODOO_ENABLED=false

# Base URL of your Odoo instance, no trailing slash
ODOO_URL=https://your-company.odoo.com
# Database name (Odoo.sh / on-premise: shown on the login screen)
ODOO_DB=your-database
# Login of an Odoo user with Sales + Inventory access
ODOO_USERNAME=storefront@yourcompany.com
# API key for that user (Preferences > Account Security > New API Key)
ODOO_API_KEY=

# Currency code shown on the storefront, must match the Odoo company currency
ODOO_CURRENCY=USD
# "true" confirms orders immediately (sale.order.action_confirm). "false" creates quotations.
ODOO_CONFIRM_ORDERS=false


# Cloudflare R2 for blog images and other uploads. In the Cloudflare dashboard: create a bucket, then an
# R2 API token with Object Read & Write access to that bucket. Give the bucket a public address
# (custom domain or the r2.dev address) and put it in R2_PUBLIC_URL, with no trailing slash.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Live notifications for the staff admin. Run `npm run realtime` in a second terminal next to `npm run dev`.
# Port the realtime process listens on, and the page origins allowed to connect (comma-separated).
REALTIME_PORT=4001
REALTIME_ALLOWED_ORIGINS=http://localhost:3000
# Address the admin browser uses. Leave blank to use the same host as the admin page on port 4001.
NEXT_PUBLIC_REALTIME_URL=
